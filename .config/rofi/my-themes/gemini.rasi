* {
    bg-color:     #ffffff; /* Crisp, clean pure white background */
    bg-alt:       #f3f4f6; /* Premium soft gray for the selected item hover */
    fg-color:     #1f2937; /* Dark slate gray for highly legible text (not harsh pure black) */
    accent-color: #3b82f6; /* Vibrant, modern blue accent for the search icon/active text */
    border-color: #e5e7eb; /* Ultra-subtle light gray border to separate elements cleanly */
}

window {
    width:            800px;         
    location:         center;
    anchor:           center;
    x-offset:         0;
    y-offset:         -150px;        
    border:           2px;
    border-radius:    12px;          
    border-color:     @border-color;
    background-color: @bg-color;
}

mainbox {
    background-color: transparent;
    children:         [ inputbar, listview ];
    padding:          10px;          
}

inputbar {
    background-color: transparent;
    children:         [ prompt, entry ];
    padding:          0px 0px 0px 0px; 
}

prompt {
    background-color: transparent;
    text-color:       @accent-color;
    font:             "JetBrains Mono 15"; 
    padding:          0px 0px 0px 0px;
}

entry {
    background-color: transparent;
    text-color:       @fg-color;
    placeholder:      "Search...";
    placeholder-color:#585b70;
}

listview {
    background-color: transparent;
    columns:          3;
    lines:            4;             
    spacing:          0px;           
    cycle:            true;
    dynamic:          true;
    layout:           vertical;
}

element {
    background-color: transparent;
    text-color:       @fg-color;
    orientation:      horizontal;    
    children:         [ element-icon, element-text ];
    padding:          10px;          
    border-radius:    8px;
}

element selected {
    background-color: @bg-alt;
    text-color:       @accent-color;
}

element-icon {
    background-color: transparent;
    size:             48px;          /* Large previews for clipboard images */
    cursor:           pointer;
    padding:          0px 12px 0px 0px; 
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;           
}
