{
    "layer": "top",
    "modules-left": ["hyprland/workspaces"],
    "reload_style_on_change": true, 
    "modules-center": ["clock"],
    "modules-right": ["hyprland/submap", "group/brightness", "group/volume", "battery", "bluetooth", "network"],
    "hyprland/window": {
        "max-length": 50
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "tooltip": true,
          "tooltips": {
              "1": "Kitty",
              "2": "Secondary",
              "3": "Web & AI"
             },
        "on-click": "activate",
        "show-special": true,
        "special-visible-only": true,
        "format-icons": {
        //  "1": "",
        //  "2": "",
        //  "3": "",
          "scratchpad": "Scratchpad"
        }
    },


    "battery": {
        "interval": 60,
        "format": "{capacity}% {icon}",
        "format-icons": {
            "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
            "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
        }
    },


    "bluetooth": {
      "format": "",
      "format-disabled": "", // an empty format will hide the module
      "format-connected": " {num_connections}",
      "tooltip-format": "{controller_alias}\t{controller_address}",
      //"tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
      "tooltip-format-connected": "{device_enumerate}",
      "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
      "on-click": "blueman-manager"
    },


    "network": {
        "format": "",
        "format-wifi": "",
        "format-ethernet": "",
        "format-disconnected": "󰤭", //An empty format will hide the module.
        "tooltip-format": "{ifname} via {gwaddr} 󰊗",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname} ",
        "tooltip-format-disconnected": "󰖪",
        "max-length": 50,
        //"on-click": "exec nmrs"
    },


    "clock": {
      "format": "󰥔 {:%a, %d %b, %I:%M %p}",
      "tooltip-format": "<tt><small>{calendar}</small></tt>",
      "calendar": {
        "format": {
          "today": "<span color='#75f1fa'><b>{}</b></span>"
        }
      },
      "on-click": "exec brave --profile-directory=Default --app=https://calendar.google.com"
    },

    "custom/reminder": {
      "format": "   hello {text}",
      "tooltip-format": " hole amigo{text}",
      "on-click": "kitty --class custom-floating bash /home/rudra/scripts/dates-reminder/reminder.sh"

    },

    "custom/vpn": {
        "format": "{}",
        "return-type": "json",
        "signal": 1,
        "exec": "~/.config/waybar/scripts/vpn.sh",
        "on-click": "protonvpn connect && pkill -RTMIN+1 waybar",
        "on-click-right": "protonvpn disconnect && pkill -RTMIN+1 waybar"
    },

    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": " ",
        "format-icons": {
            "default": [" ", " "]
        },
        "scroll-step": 1,
        "ignored-sinks": ["Easy Effects Sink"],
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },

    "group/volume": {
      "orientation": "horizontal",
      "modules": [
        "pulseaudio",
        "pulseaudio/slider"
      ]
    }
 
}
